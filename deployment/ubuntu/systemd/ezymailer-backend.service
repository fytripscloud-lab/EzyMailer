[Unit]
Description=EzyMailer Backend API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ezymailer
EnvironmentFile=/etc/ezymailer/ezymailer.env
ExecStart=/opt/ezymailer/.venv/bin/uvicorn backend.local_api:app --host 0.0.0.0 --port 8765
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
