# EzyMailer live environment

EZYM_MAILER_API_HOST=0.0.0.0
EZYM_MAILER_API_PORT=8765
EZYM_MAILER_ADMIN_API_BASE_URL=http://127.0.0.1:8765
EZYM_MAILER_BOOTSTRAP_API=0

# Hosted Ubuntu deployment must use the dedicated live database only.
# Do not point this file at the local development database on the live server.
EZYM_MAILER_DB_HOST=<live-db-host>
EZYM_MAILER_DB_PORT=3306
EZYM_MAILER_DB_USER=<live-db-user>
EZYM_MAILER_DB_PASSWORD=<live-db-password>
EZYM_MAILER_DB_NAME=ezymailer

EZYM_MAILER_JWT_SECRET=<strong-random-secret>
