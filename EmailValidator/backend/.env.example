# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Storage (relative to backend/ working directory)
IMPORTED_DIR=imported
JOB_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# Upload limits
MAX_UPLOAD_SIZE_MB=25
MAX_ROWS=100000
ALLOWED_EXTENSIONS=.xlsx,.xls,.csv

# Validation engine concurrency
DNS_CONCURRENCY=20
# Keep this conservative in production. Gmail/Outlook/Yahoo etc. rate-limit and
# reputation-flag IPs that open many concurrent SMTP connections just to probe
# RCPT TO with no real mail ever sent. 5 is a safe starting point; only raise it
# on a dedicated VPS IP with its own sending reputation, and watch your Unknown
# rate before going higher.
SMTP_CONCURRENCY=5
DNS_TIMEOUT_SECONDS=5
SMTP_TIMEOUT_SECONDS=8
SMTP_RETRIES=1
DNS_CACHE_TTL_SECONDS=600
# Use a domain/address you actually control here. A HELO/MAIL FROM that doesn't
# resolve, or that has no PTR/SPF record pointing back at this server's IP, gets
# many receiving servers to reject or greylist the probe outright regardless of
# whether the recipient mailbox is real — inflating your Unknown rate for
# reasons that have nothing to do with the email being checked.
SMTP_HELO_DOMAIN=example.com
SMTP_FROM_ADDRESS=verify@example.com
ENABLE_SMTP_CHECK=true
ENABLE_CATCH_ALL_CHECK=true
# Domain the /api/v1/system/diagnostics endpoint probes to report whether
# outbound port 25 is actually open from this host.
DIAGNOSTICS_TEST_DOMAIN=gmail.com

# Progress persistence
PROGRESS_FLUSH_INTERVAL=25

# Rate limiting
UPLOAD_RATE_LIMIT=10/minute
START_RATE_LIMIT=10/minute
